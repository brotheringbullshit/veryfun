		$RET = _AESDECRYPTCBC_PAD ( $AESCTX , $IV , $DATA )
	EndSwitch
	If BinaryLen ( $RET ) = 0 Then Return SetError ( 1 , 0 , Binary ( "" ) )
	Return $RET
